<mvc:View
    controllerName="zsuporder.controller.SupervisorOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:ui="sap.ui.unified"
    displayBlock="true"
>
    <Page
        id="page"
        title="Supervisor Order"
        showNavButton="true"
        navButtonPress="onNavBack"
    >
        <content>

            <f:SimpleForm
                id="orderForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="12"
                labelSpanS="12"
                adjustLabelSpan="false"
                columnsXL="2"
                columnsL="2"
                columnsM="1"
            >

                <!-- ================================================= -->
                <!-- ORDER INFORMATION -->
                <!-- ================================================= -->

                <core:Title text="Order Information" />

                <Label text="User Status" />

                <Select
                    id="idUserStatus"
                    change="handleSaveButtonEnabled"
                    items="{ path: '/ZAE_VH_UserStatus_09', length: 500 }"
                >
                    <core:ListItem
                        key="{UserStatus}"
                        text="{UserStatusName}"
                        additionalText="{UserStatusShortName}"
                    />
                </Select>

                <Label text="Order No" />

                <Input
                    id="idOrderNo"
                    editable="false"
                    placeholder="Auto-generated"
                />

                <Label text="Order Date" />

                <DatePicker
                    id="orderDate"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="dd.MM.yyyy"
                />

                <Label text="Order Long Text" />

                <Input
                    id="longText"
                    placeholder="Enter long text..."
                    width="100%"
                />


                <!-- ================================================= -->
                <!-- CUSTOMER DETAILS -->
                <!-- ================================================= -->

                <core:Title text="Customer Details" />

                <Label text="Customer Name" />

                <Input
                    id="customerName"
                    placeholder="Enter customer name"
                />

                <Label text="Mobile No" />

                <Input
                    id="mobileNo"
                    type="Tel"
                    placeholder="+968 XXXXX XXXXX"
                />

                <Label text="Location" />

                <Input
                    id="location"
                    placeholder="Enter location"
                />

                <Label text="Land Line No" />

                <Input
                    id="landLineNo"
                    type="Tel"
                />


                <!-- ================================================= -->
                <!-- JOB DETAILS -->
                <!-- ================================================= -->

                <core:Title text="Job Details" />

                <Label text="Invoice Details" />

                <Input
                    id="invoiceDetails"
                />

                <Label text="Invoice Date" />

                <DatePicker
                    id="invoiceDate"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="dd.MM.yyyy"
                />

                <Label text="Goods Repair/Collection Date" />

                <DatePicker
                    id="repairDate"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="dd.MM.yyyy"
                />

                <Label text="Job Ref W/OW" />

                <Select
                    id="jobRef"
                    change="handleSaveButtonEnabled"
                    items="{ path: '/ZAE_VH_MaintenanceActivityType', length: 500 }"
                >
                    <core:ListItem
                        key="{MaintenanceActivityType}"
                        text="{MaintenanceActivityTypeName}"
                    />
                </Select>

                <Label text="Model Number" />

                <Input
                    id="modelNo"
                />

                <Label text="Serial Number" />

                <Input
                    id="serialNo"
                />


                <!-- ================================================= -->
                <!-- RESPONSIBLE PERSONS -->
                <!-- ================================================= -->

                <core:Title text="Responsible Persons" />

                <Label text="Person Responsible (Emp Name)" />

                <Input
                    id="empName"
                    placeholder="Employee Name"
                />

                <Label text="Employee Code" />

                <Select
                    id="empCode"
                    change="onEmpCodeChange"
                    items="{ path: '/I_PersWrkAgrmtSrchHelp', length: 500 }"
                >
                    <core:ListItem
                        key="{PersonWorkAgreement}"
                        text="{PersonWorkAgreement}"
                    />
                </Select>

                <Label text="Outsource Technician Name" />

                <Select
                    id="techName"
                    change="handleSaveButtonEnabled"
                    items="{ path: '/I_PersWrkAgrmtSrchHelp', length: 500 }"
                >
                    <core:ListItem
                        key="{PersonWorkAgreement}"
                        text="{PersonFullName}"
                    />
                </Select>

                <Label text="Vendor Code" />

                <Input
                    id="vendorCode"
                />


                <!-- ================================================= -->
                <!-- TECHNICAL INFORMATION -->
                <!-- ================================================= -->

                <core:Title text="Technical Information" />

                <Label text="Parts EHA" />

                <Input
                    id="partsEHA"
                />

                <Label text="Damage EHA" />

                <Input
                    id="damageEHA"
                />

                <Label text="Cause EHA" />

                <Input
                    id="causeEHA"
                />


                <!-- ================================================= -->
                <!-- DOCUMENTS AND SIGNATURE -->
                <!-- ================================================= -->

                <core:Title text="Documents &amp; Signature" />


                <!-- ================= INVOICE ================= -->

                <Label text="Customer Invoice" />

                <VBox
                    width="100%"
                    class="sapUiSmallMarginBottom"
                >

                    <ui:FileUploader
                        id="fileUploader"
                        width="100%"
                        multiple="false"
                        fileType="pdf,jpg,jpeg,png"
                        placeholder="Select invoice"
                        sendXHR="true"
                        change="onInvoiceFileChange"
                    />

                    <Button
                        id="idUploadInvoiceButton"
                        text="Upload Invoice"
                        icon="sap-icon://upload"
                        type="Emphasized"
                        press="onUploadInvoice"
                        enabled="false"
                        width="100%"
                        class="sapUiSmallMarginTop"
                    />

                </VBox>


                <!-- ================= SIGNATURE ================= -->

                <Label text="Customer Signature" />

                <VBox
                    id="signatureContainer"
                    width="100%"
                    class="sapUiSmallMarginBottom"
                >

                    <VBox
                        id="signatureVBox"
                        width="100%"
                        height="220px"
                    />

                    <Button
                        id="idUploadSignatureButton"
                        text="Upload Signature"
                        icon="sap-icon://upload"
                        type="Emphasized"
                        press="onUploadSignature"
                        enabled="false"
                        width="100%"
                        class="sapUiSmallMarginTop"
                    />

                </VBox>

            </f:SimpleForm>

        </content>


        <!-- ========================================================= -->
        <!-- FOOTER -->
        <!-- ========================================================= -->

        <footer>

            <Toolbar>

                <ToolbarSpacer />

                <Button
                    id="idSaveButton"
                    text="Save Order"
                    type="Emphasized"
                    press="onSaveOrder"
                    icon="sap-icon://save"
                    enabled="false"
                />

                <Button
                    text="Clear Signature"
                    press="onClearSignature"
                    type="Reject"
                    icon="sap-icon://delete"
                />

                <Button
                    text="Cancel"
                    type="Reject"
                    press="onCancel"
                />

            </Toolbar>

        </footer>

    </Page>

</mvc:View>