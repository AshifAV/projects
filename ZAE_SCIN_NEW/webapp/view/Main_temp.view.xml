						</f:Form>
					</VBox>
					<layout:VerticalLayout>
						<layout:HorizontalLayout>
							<CustRMC:RadialMicroChart size="S"
								percentage="{ parts:['mCustIdentification>/customerInfo/to_EquipmentVBAPSOTagData/'], formatter:'.fnNPSScoreFormat' }" press="press"
								class="sapUiSmallMargin"></CustRMC:RadialMicroChart>
							<CustRMC:RadialMicroChart size="S"
								percentage="{ parts:['mCustIdentification>/customerInfo/to_EquipmentVBAPSOTagData/'], formatter:'.fnPDSSScoreFormat' }" press="press"
