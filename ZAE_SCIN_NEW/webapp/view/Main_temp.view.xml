														</smartField:objectStatus>
													</smartField:ControlProposal>
												</smartField:controlProposal>
											</smartField:SmartField>
										</f:FormElement>-->
										<f:FormElement label="Used Car Type">
											<smartField:SmartField value="{UsedCarType}">
												<smartField:configuration>
													<smartField:Configuration displayBehaviour="descriptionAndId"/>
												</smartField:configuration>
											</smartField:SmartField>
										</f:FormElement>
										<f:FormElement label="{i18n>ServiceContractStatus}" visible="{mCustIdentification>/SchemaTransactionType/RelForWarRecSC}">
											<ObjectStatus class="sapUiSmallMarginBottom" text="{ContractStatusText_new}"
												icon="{ parts: ['ContractStatusCriti_new'],formatter:'.fnServiceContractStatusIcon'}"
												state="{ parts: ['ContractStatusCriti_new'],formatter:'.fnServiceContractStatusCriti'}"/>
										</f:FormElement>
										<f:FormElement label="{i18n>RecallStatus}" visible="{mCustIdentification>/SchemaTransactionType/RelForWarRecSC}">
											<ObjectStatus id="ObjectStatusRecall" class="sapUiSmallMarginBottom"/>
										</f:FormElement>
									</f:formElements>
								</f:FormContainer>
								<f:FormContainer title="{i18n>WarrantyInformation} " visible="{mCustIdentification>/SchemaTransactionType/RelForWarRecSC}">
									<f:FormElement label="{i18n>CustomerWarrantyStatus}">
										<smartField:SmartField value="{WarrantyStatus_new}">
											<smartField:controlProposal>
												<smartField:ControlProposal>
													<smartField:objectStatus>
														<smartField:ObjectStatus criticality="{WarrantyStatusCriti_new}"/>
													</smartField:objectStatus>
												</smartField:ControlProposal>
											</smartField:controlProposal>
										</smartField:SmartField>
									</f:FormElement>
									<f:FormElement label="{i18n>CustomerWarrantyDescription}">
										<smartField:SmartField value="{to_EquipmentWarrantyStatus/MasterWarrantyDescription}"/>
									</f:FormElement>
									<f:FormElement label="{i18n>CustomerWarrantyStartDate}">
										<smartField:SmartField value="{to_EquipmentWarrantyStatus/WarrantyStartDate}"/>
									</f:FormElement>
									<f:FormElement label="{i18n>CustomerWarrantyEndDate}">
										<smartField:SmartField value="{to_EquipmentWarrantyStatus/WarrantyEndDate}"/>
									</f:FormElement>
									<f:FormElement label="{i18n>OEMWarrantyStatus}">
										<smartField:SmartField value="{OEMWarrantyStatus_new}">
											<smartField:controlProposal>
												<smartField:ControlProposal>
													<smartField:objectStatus>
														<smartField:ObjectStatus criticality="{OEMWarrantyStatusCriti_new}"/>
													</smartField:objectStatus>
												</smartField:ControlProposal>
											</smartField:controlProposal>
										</smartField:SmartField>
									</f:FormElement>
									<f:FormElement label="{i18n>OEMWarrantyDescription}">
										<smartField:SmartField value="{OEMWarrantyStatusText_new}"/>
									</f:FormElement>
									<f:FormElement label="{i18n>OEMWarrantyStartdate}">
										<smartField:SmartField value="{to_EquipmentWarrantyStatusOEM/WarrantyStartDate}"/>
									</f:FormElement>
									<f:FormElement label="{i18n>OEMWarrantyEndDate}">
										<smartField:SmartField value="{to_EquipmentWarrantyStatusOEM/WarrantyEndDate}"/>
									</f:FormElement>
								</f:FormContainer>
								<f:FormContainer title="{i18n>ServiceContract} "
									visible="{ parts: ['ContractStatus_new','mCustIdentification>/SchemaTransactionType/RelForWarRecSC'],formatter:'.fnServiceContractVisible'}">
									<f:FormElement label="{i18n>Service Contract}">
										<Link text="{ parts: ['mCustIdentification>/customerInfo/to_ServiceContract01/results'],formatter:'.fnfindServiceContractNumber'}"
											press="onContractLinkPress"/>
									</f:FormElement>
									<f:FormElement label="{i18n>Defarred Revenue}">
										<ObjectNumber number="{ parts:['mCustIdentification>/customerInfo/to_ServiceContract01/results'], formatter:'.fnFormatDeferredRevenue' }"
											unit="{ parts:['mCustIdentification>/customerInfo/to_ServiceContract01/results'], formatter:'.fnFormatCurrency' }"/>
									</f:FormElement>
								</f:FormContainer>
