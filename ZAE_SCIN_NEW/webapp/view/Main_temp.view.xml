									<Button id="SCIN_B05" icon="sap-icon://action" text="{i18n>MoreInfo}" type="Default" tooltip="{i18n>MoreInfo}" press="fnMoreCustomerInfo"/>
								</Toolbar>
							</f:toolbar>
							<f:layout>
								<f:ColumnLayout columnsM="2" columnsL="3" columnsXL="4"/>
							</f:layout>
							<f:formContainers>
								<f:FormContainer>
									<f:formElements>
										<f:FormElement label="{i18n>Name}">
											<f:fields>
												<Text id="SCIN_T11"
													text="{parts: ['mCustIdentification>/customerInfo/to_CurrentOwner/CustomerName', 'mCustIdentification>/customerInfo/to_CurrentOwner/Partner'], formatter: '.formatNameAndValuePair'}"/>
											</f:fields>
										</f:FormElement>
										<f:FormElement label="{i18n>City}">
											<f:fields>
												<Text id="SCIN_T12" text="{mCustIdentification>/customerInfo/to_CurrentOwner/CityName}"/>
											</f:fields>
										</f:FormElement>
										<f:FormElement label="{i18n>Country}">
											<f:fields>
												<Text id="SCIN_T13" text="{mCustIdentification>/customerInfo/to_CurrentOwner/Country}"/>
											</f:fields>
										</f:FormElement>
										<f:FormElement label="{i18n>PostalCode}">
											<f:fields>
												<Text id="SCIN_T14" text="{mCustIdentification>/customerInfo/to_CurrentOwner/PostalCode}"/>
											</f:fields>
										</f:FormElement>
										<f:FormElement label="{i18n>Telephone}">
											<f:fields>
												<Text id="SCIN_T15" text="{mCustIdentification>/customerInfo/to_CurrentOwner/TelephoneNumber1}"/>
											</f:fields>
										</f:FormElement>
										<f:FormElement label="{i18n>Email}">
											<f:fields>
												<Text id="SCIN_T16" text="{mCustIdentification>/customerInfo/to_CurrentOwner/EmailAddress}"/>
											</f:fields>
										</f:FormElement>
										<f:FormElement label="{i18n>CPRNo}">
											<f:fields>
												<Text text="{mCustIdentification>/customerInfo/to_CurrentOwner/idnumber}"/>
											</f:fields>
										</f:FormElement>
										<f:FormElement label="{i18n>MobileNo}">
											<f:fields>
												<Text text="{mCustIdentification>/customerInfo/to_CurrentOwner/TelephoneNumber2}"/>
											</f:fields>
										</f:FormElement>
										<f:FormElement label="{i18n>CustomerBlockedStatus}" visible="false">
											<f:fields>
												<Text text="{mCustIdentification>/customerInfo/to_CurrentOwner/BlockedStatus}"/>
											</f:fields>
										</f:FormElement>
									</f:formElements>
								</f:FormContainer>
							</f:formContainers>
						</f:Form>
