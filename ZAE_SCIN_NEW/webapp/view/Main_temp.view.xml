					<VBox class="sapUiSmallMargin" visible="{mCustIdentification>/uiOnly/visible/vBoxSearchResults}">
						<Panel >
							<headerToolbar>
								<OverflowToolbar height="3rem">
									<Title text="{i18n>ExtendedWarranty}"/>
									<ToolbarSpacer/>
								</OverflowToolbar>
							</headerToolbar>
							<content>
								<smartTable:SmartTable id="SmartTableExtendedWarranty" entitySet="ZAE_C_T_EQU_EXW" tableType="ResponsiveTable" useExportToExcel="false"
