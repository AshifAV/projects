	<App id="Main">
		<pages>
			<Page title="{i18n>title}">
				<headerContent>
					<!--<Button id="SCIN_B15" text="Create Complain" type="Default" tooltip="Create Complain" press="onCreateComplain"-->
					<!--	enabled="{= ${mCustIdentification>/TBLSalesAreaLength} > 0 ? ${mCustIdentification>/TBLContactPersonLength} > 0 ? true :false : false}"/>-->
					<Button id="SCIN_B01" text="{i18n>CreateCustomer}" type="Default" tooltip="{i18n>CreateCustomer}" press="onCreateCustomer"
						enabled="{= ${mCustIdentification>/WorkShop}? true:false }"/>
					<Button id="SCIN_B02" text="{i18n>CreateEquipment}" type="Default" tooltip="{i18n>CreateEquipment}" press="onCreateEquipment"/>
					<Button id="SCIN_B13" text="{i18n>CreateServiceContractQuotation} " type="Default" tooltip="{i18n>CreateServiceContractQuotation} "
						press="onPressCreateServiceContractQuotation"
						enabled="{ parts: ['mCustIdentification>/WorkShop', 'mCustIdentification>/customerInfo/to_CurrentOwner/Partner' ],formatter:'.fnEnableCreateServiceContractQuotation'}"/>
					<Button id="SCIN_B03" icon="sap-icon://notification-2" text="{= ${mCustIdentification>/ServiceRequestList}.length }"
						visible="{= ${mCustIdentification>/ServiceRequestList}.length > 0 }" type="Default" tooltip="Message" press="handleMessagePress"/>
				</headerContent>
				<content>
					<smartFilterBar:SmartFilterBar id="SCIN_smartFilterBar" enableBasicSearch="false" entitySet="ZAE_I_Equipment_04"
						persistencyKey="SCINUniqueAndStablePersistencyKey" initialized="onEquipmentInputInitialized" considerSelectionVariants="false"
						visible="true" search="onSearch" liveMode="false" showFilterConfiguration="false" useToolbar="false">
						<smartFilterBar:controlConfiguration>
							<smartFilterBar:ControlConfiguration index="" key="Plant" label="{i18n>Plantt}" visibleInAdvancedArea="true" groupId="_BASIC"
								mandatory="mandatory">
								<smartFilterBar:customControl>
									<Input id="SCIN_I01" placeholder="{i18n>PLANT}" type="Text" showSuggestion="true" showValueHelp="true" valueHelpOnly="true"
										valueHelpRequest="handlePlantValueHelp" width="15rem" value="{mCustIdentification>/WorkShop}" maxSuggestionWidth="25%"
										change="onPlantSelected" suggestionItems="{/ZAE_I_Plant_03}" textFormatMode="ValueKey" suggest="suggestHelp">
										<suggestionItems>
											<core:ListItem key="{ValuationArea}" text="{PlantName}" additionalText="{ValuationArea}"/>
										</suggestionItems>
									</Input>
								</smartFilterBar:customControl>
							</smartFilterBar:ControlConfiguration>
							<!--<smartFilterBar:ControlConfiguration   key="Equipment" visibleInAdvancedArea="true" filterType="single" index="05"/>-->
							<smartFilterBar:ControlConfiguration key="Equipment" visibleInAdvancedArea="true" filterType="single" index="10">
								<smartFilterBar:customControl>
									<MultiInput id="EquipmentVH" valueHelpRequest=".onEQUIValueHelpRequested" valueHelpOnly="true" showValueHelp="true" enabled="true"
										editable="{= ${mCustIdentification>/WorkShop} !== ''}"
										suggestionRows="{ path: '/ZAE_VH_Equipment_06', sorter: { path: 'Equipment' }, length: 10 }" placeholder="{i18n>SelectEquipment}"
										change="fnRequiredFieldValidation">
										<suggestionColumns>
											<Column>
												<Label text="{i18n>Equipment}"/>
											</Column>
											<Column>
												<Label text="{i18n>EquipmentName}"/>
											</Column>
											<Column>
												<Label text="{i18n>LicenseNum}"/>
											</Column>
										</suggestionColumns>
										<suggestionRows>
											<ColumnListItem>
												<cells>
													<Label text="{Equipment}"/>
													<Label text="{EquipmentName}"/>
													<Label text="{LicenseNum}"/>
												</cells>
											</ColumnListItem>
										</suggestionRows>
									</MultiInput>
								</smartFilterBar:customControl>
							</smartFilterBar:ControlConfiguration>
						</smartFilterBar:controlConfiguration>
					</smartFilterBar:SmartFilterBar>
					<MessagePage id="msgPage" class="CustMessagePage" visible="{mCustIdentification>/uiOnly/visible/MessagePage}" showHeader="false"
						text="{i18n>Searchplate}" description="" icon="" iconAlt=""/>
					<VBox id="SCIN_BoxSearchResults" class="sapUiSmallMargin" visible="{mCustIdentification>/uiOnly/visible/vBoxSearchResults}">
						<f:Form editable="false">
							<f:toolbar>
								<Toolbar >
									<Title text="{i18n>vehicleInfo}" level="H4" titleStyle="H4"/>
									<ToolbarSpacer/>
									<Button id="SCIN_B04" icon="sap-icon://action" text="{i18n>MoreInfo}" type="Default" tooltip="More Information" press="fnMoreEquipmentInfo"/>
								</Toolbar>
							</f:toolbar>
							<f:layout>
								<f:ColumnLayout columnsM="2" columnsL="2" columnsXL="4"/>
							</f:layout>
							<f:formContainers>
								<f:FormContainer title="{i18n>GenInfo}">
									<f:formElements>
										<f:FormElement label="{i18n>Equipment}">
											<smartField:SmartField value="{Equipment}">
												<smartField:configuration>
													<smartField:Configuration displayBehaviour="descriptionAndId"/>
												</smartField:configuration>
											</smartField:SmartField>
										</f:FormElement>
										<f:FormElement label="{i18n>VinNumber}">
											<smartField:SmartField value="{FleetVin}">
												<smartField:configuration>
													<smartField:Configuration displayBehaviour="descriptionAndId"/>
												</smartField:configuration>
											</smartField:SmartField>
										</f:FormElement>
										<f:FormElement label="{i18n>RegistrationNumber}">
											<smartField:SmartField value="{LicenseNum}"/>
										</f:FormElement>
										<f:FormElement label="{i18n>InsurPolicy}">
											<smartField:SmartField value="{FleetNum}"/>
										</f:FormElement>
										<!--	<f:FormElement label="Business Partner">
											<smartField:SmartField value="{Partner}"/> 
										</f:FormElement>-->
										<f:FormElement label="{i18n>Material}">
											<smartField:SmartField value="{Material}"/>
										</f:FormElement>
										<f:FormElement label="{i18n>Make}">
											<smartField:SmartField value="{Make}">
												<smartField:configuration>
													<smartField:Configuration displayBehaviour="descriptionAndId"/>
												</smartField:configuration>
											</smartField:SmartField>
										</f:FormElement>
										<f:FormElement label="{i18n>Model}">
											<smartField:SmartField value="{Model}">
												<smartField:configuration>
													<smartField:Configuration displayBehaviour="descriptionAndId"/>
												</smartField:configuration>
											</smartField:SmartField>
										</f:FormElement>
										<f:FormElement label="{i18n>DevelopmentLine}">
											<smartField:SmartField value="{DevelopmentLine}">
												<smartField:configuration>
													<smartField:Configuration displayBehaviour="descriptionAndId"/>
												</smartField:configuration>
											</smartField:SmartField>
										</f:FormElement>
										<f:FormElement label="{i18n>ModelLine}">
											<smartField:SmartField value="{ModelLine}">
												<smartField:configuration>
													<smartField:Configuration displayBehaviour="descriptionAndId"/>
												</smartField:configuration>
											</smartField:SmartField>
										</f:FormElement>
										<f:FormElement label="{i18n>ProductYear}">
											<smartField:SmartField id="idModelYear" value="{ModelYear}"/>
										</f:FormElement>
										<f:FormElement label="{i18n>ManufactureYear}">
											<smartField:SmartField id="idMfgYear" value="{MfgYear}"/>
										</f:FormElement>
										<f:FormElement label="{i18n>ExternalColor}">
											<smartField:SmartField value="{BodyColor}">
												<smartField:configuration>
													<smartField:Configuration displayBehaviour="descriptionAndId"/>
												</smartField:configuration>
											</smartField:SmartField>
										</f:FormElement>
