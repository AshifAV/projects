										<ObjectNumber number="{ parts:['mCustIdentification>/customerInfo/to_SmartServiceContract/results'], formatter:'.fnFormatDeferredRevenue' }"
											unit="{ parts:['mCustIdentification>/customerInfo/to_SmartServiceContract/results'], formatter:'.fnFormatCurrency' }"/>
									</f:FormElement>
								</f:FormContainer>
