					<VBox class="sapUiSmallMargin" visible="{mCustIdentification>/uiOnly/visible/vBoxSearchResults}">
						<Panel >
							<headerToolbar>
								<OverflowToolbar height="3rem">
									<Title text="{i18n>Complains}"/>
									<ToolbarSpacer/>
								</OverflowToolbar>
							</headerToolbar>
							<content>
								<smartTable:SmartTable id="SmartTableComplainList" entitySet="ZAE_C_Activity_05" tableType="ResponsiveTable" useExportToExcel="false"
									useVariantManagement="false" useTablePersonalisation="true" header="{i18n>LineItems}" showRowCount="true" enableAutoBinding="true"
									initiallyVisibleFields="Activity,CreatedOn,created_by,person_resp,UserStatus,description"
									beforeRebindTable="onBeforeRebindSmartTableComplainList">
									<smartTable:customToolbar>
										<OverflowToolbar design="Transparent">
											<ToolbarSpacer/>
											<Button id="SCIN_B15" text="{i18n>CreateComplain}" type="Default" tooltip="{i18n>CreateComplain}" press="onCreateComplain"
												enabled="{= ${mCustIdentification>/TBLSalesAreaLength} > 0 ? ${mCustIdentification>/TBLContactPersonLength} > 0 ? true :false : false}"/>
										</OverflowToolbar>
									</smartTable:customToolbar>
									<smartTable:layoutData >
										<FlexItemData growFactor="1" baseSize="0%"/>
									</smartTable:layoutData>
									<Table mode="None" updateFinished="onBeforeRebindSmartTableComplainList">
										<columns>
											<Column hAlign="Left">
												<customData>
													<core:CustomData key="p13nData" value='\{"columnKey": "Activity1", "maxLength": "10","columnIndex":"0"}'/>
												</customData>
												<Text text="{i18n>Complains}"/>
											</Column>
										</columns>
										<items>
											<ColumnListItem>
												<cells>
													<VBox>
														<Link text="{Activity}" press="fnHandelComplainLinkPress"/>
													</VBox>
												</cells>
											</ColumnListItem>
										</items>
									</Table>
								</smartTable:SmartTable>
							</content>
						</Panel>
					</VBox>
					<VBox id="idvehiclehistory" class="sapUiSmallMargin" visible="{mCustIdentification>/uiOnly/visible/vBoxSearchResults}">
						<Panel >
							<headerToolbar>
								<OverflowToolbar height="3rem">
									<Title text="{i18n>vehiclehistory}"/>
									<ToolbarSpacer/>
								</OverflowToolbar>
							</headerToolbar>
							<content>
								<smartTable:SmartTable id="vehiclehistory" entitySet="ZAE_C_ServiceOrderHistory_01" tableType="ResponsiveTable" useExportToExcel="true"
									useVariantManagement="false" useTablePersonalisation="true" header="{i18n>LineItems}" showRowCount="true"
									persistencyKey="SmartTableAnalytical_Explored" enableAutoBinding="true"
									initiallyVisibleFields='ServiceOrder,ServiceOrderType,Invoice,Equipment,ServiceDocumentDescription,SoldToParty,BillToParty,LicenseNum,HistoryItems,PostingDate'
									beforeRebindTable="onBeforeRebindHistoryTable">
									<smartTable:layoutData >
										<FlexItemData growFactor="1" baseSize="0%"/>
									</smartTable:layoutData>
									<!--<smartTable:semanticObjectController>   	app:p13nDialogSettings="{sort:{items:[{ columnKey: 'PostingDate', operation: 'Ascending' }]}}"
										<sl:SemanticObjectController enableAvailableActionsPersonalization='\{"ServiceOrder":true\}'/>
									</smartTable:semanticObjectController>-->
									<Table alternateRowColors="true" growing="true" growingThreshold="10">
										<columns>
											<Column hAlign="Left">
												<customData>
													<core:CustomData key="p13nData" value='\{"columnKey": "ServiceOrder1", "maxLength": "15","columnIndex":"0"}'/>
												</customData>
												<Text text="{i18n>ServiceOrderNumber}"/>
											</Column>
											<!--<Column hAlign="Left">
												<customData>
													<core:CustomData key="p13nData"
														value='\{"columnKey": "ServiceOrder2",  "maxLength": "15","columnIndex":"1"}'/>
												</customData>
												<Text text="Service Order"/>
											</Column>-->
										</columns>
										<items>
											<ColumnListItem type="Navigation" press="onServiceListPress">
												<cells>
													<!--	<Link text="{ServiceOrder}" press="fnHandelServiceOrderLinkPress"/>-->
													<VBox>
														<Link text="{ServiceOrder}" press="fnHandelServiceOrderLinkPress" visible="{= ${HistoryItems}==='NEW' ? true:false }"/>
														<Text text="{ServiceOrder}" visible="{= ${HistoryItems}==='NEW' ? false:true }"/>
													</VBox>
												</cells>
											</ColumnListItem>
										</items>
									</Table>
								</smartTable:SmartTable>
							</content>
						</Panel>
					</VBox>
				</content>
				<footer>
					<Toolbar>
						<Button id="SCIN_B06" icon="sap-icon://alert" text="{= ${message>/}.length }" visible="{= ${message>/}.length > 0 }" type="Emphasized"
							press="onMessagePopoverPress"/>
						<ToolbarSpacer width="4px"/>
						<!--	<Input id="SCIN_I01" placeholder="{i18n>PLANT}" type="Text" showSuggestion="true" showValueHelp="true"
							valueHelpRequest="handlePlantValueHelp" width="15rem" value="{mCustIdentification>/WorkShop}" maxSuggestionWidth="25%"
							change="onPlantSelected" suggestionItems="{/ZAE_I_Plant_03}" textFormatMode="ValueKey" suggest="suggestHelp">
							<suggestionItems>
								<core:ListItem key="{ValuationArea}" text="{PlantName}" additionalText="{ValuationArea}"/>
							</suggestionItems>
						</Input>-->
						<Input id="SCIN_I02" placeholder="{i18n>Category}" type="Text" showSuggestion="true" showValueHelp="true"
							valueHelpRequest="handleCategoryValueHelp" value="{mCustIdentification>/Category}" width="15rem" maxSuggestionWidth="25%"
							textFormatMode="ValueKey" editable="{= ${mCustIdentification>/WorkShop} !== '' &amp;&amp; ${mCustIdentification>/Equipment} !== ''}"/>
						<!-- suggestionItems="{/ZAE_I_CategorizationSchema}"   suggest="suggestHelp"   editable
					   <suggestionItems>
								<core:ListItem key="{cat_id}" text="{cat_label}" additionalText="{cat_id}"/>
							</suggestionItems>
						</Input>-->
						<Input id="SCIN_I03" placeholder="{i18n>InsuranceCompany}" type="Text" showSuggestion="true" showValueHelp="true"
							valueHelpRequest="handleInsurerValueHelp" width="15rem" value="{mCustIdentification>/Insurer}" maxSuggestionWidth="25%"
							suggestionItems="{/ZAE_I_Insurer}" textFormatMode="ValueKey" suggest="suggestHelp">
							<suggestionItems>
								<core:ListItem key="{BusinessPartner}" text="{BusinessPartnerFullName}" additionalText="{BusinessPartner}"/>
							</suggestionItems>
						</Input>
						<Button id="SCIN_B07" text="{i18n>ResourceLoad}" type="Accept" press="fnResourceLoad"/>
						<Button id="SCIN_B14" text="{i18n>WorkshopLoad}" type="Accept" enabled="{mCustIdentification>/customerInfo/isshowSCIN_B14}"
							press="fnWorkshopLoad"/>
						<ToolbarSpacer/>
						<Button id="SCIN_B08" text="{i18n>CreateAppointment}" type="Accept" press="fnPressCreateAppointment"
							enabled="{ parts: ['mCustIdentification>/WorkShop','mCustIdentification>/Category','mCustIdentification>/TBLSalesAreaLength','mCustIdentification>/customerInfo/CurrentOwner','mCustIdentification>/customerInfo/to_CurrentOwner/Partner','mCustIdentification>/customerInfo/to_CurrentOwner/BlockedStatus'],formatter:'.fnCheckCreateAppointmentButtonEnable'}"/>
						<Button id="SCIN_B09" text="{i18n>CreateServiceRequest}" type="Accept" press="onCreateRequestPress"
							enabled="{ parts: ['mCustIdentification>/WorkShop','mCustIdentification>/Category','mCustIdentification>/TBLSalesAreaLength','mCustIdentification>/customerInfo/CurrentOwner','mCustIdentification>/customerInfo/to_CurrentOwner/Partner','mCustIdentification>/customerInfo/to_CurrentOwner/BlockedStatus'],formatter:'.fnCheckCreateAppointmentButtonEnable'}"/>
					</Toolbar>
				</footer>
			</Page>
		</pages>
	</App>
</mvc:View>