									<f:FormElement label="Insurance Number">
										<ObjectStatus text="{SMARTInsuranceNumber}" state="{SMARTInsuranceStatus}"/>
									</f:FormElement>
									<f:FormElement label="{i18n>SMARTInsuranceStartDate}">
										<smartField:SmartField value="{SMARTInsuranceStartDate}"/>
									</f:FormElement>
									<f:FormElement label="{i18n>SMARTInsuranceEndDate}">
										<smartField:SmartField value="{SMARTInsuranceEndDate}"/>
									</f:FormElement>
								</f:FormContainer>
								<!--	<f:FormContainer title="{i18n>NPSScoreAndPDSSScore}">
									<f:FormElement label="{i18n>SMARTInsuranceEndDate}"></f:FormElement>
								</f:FormContainer>-->
