<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core"
	xmlns:smartField="sap.ui.comp.smartfield">
	<l:VerticalLayout class="sapUiContentPadding">
		<l:content>
			<f:SimpleForm id="fragAssignContactPerson" editable="true" layout="GridBoxLayout" singleContainerFullSize="true">
				<f:content>
					<Label text="{i18n>ContactPerson}"/>
					<MultiInput class="sapUiResponsivePadding" id="CUSTOMER" valueHelpRequest="onAssignContactPersonVH" valueHelpOnly="false"
						showValueHelp="true" tokenUpdate="onAssignContactPersonTokenUpdate" liveChange="fnCheckAssignContactPersonRequiredValidation"
						showSuggestion="true" suggestionItemSelected="onSelectAssignContactPerson" width="20rem"
						suggestionRows="{ path: '/ZAE_VH_BUSINESSPARTNER_05', sorter: { path: 'BusinessPartner' },suspended: true, length: 10 }"
						filterSuggests="true" suggest="handleAssignContactPersonSuggest">
						<suggestionColumns>
							<Column>
								<Label text="{i18n>BusinessPartner}"/>
							</Column>
							<Column>
								<Label text="{i18n>BusinessPartnerName}"/>
							</Column>
						</suggestionColumns>
						<suggestionRows>
							<ColumnListItem>
								<cells>
									<Label text="{BusinessPartner}"/>
									<Label text="{BusinessPartnerName}"/>
								</cells>
							</ColumnListItem>
						</suggestionRows>
					</MultiInput>
				</f:content>
			</f:SimpleForm>
		</l:content>
	</l:VerticalLayout>
</core:FragmentDefinition>