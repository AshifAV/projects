					<!--<Label text="{i18n>Region}"  />-->
					<!--<Input id="REGION" type="Text" showSuggestion="true" showValueHelp="true" valueHelpRequest="fnShowRegionValueHelp"-->
					<!--	liveChange="fnCheckCreateCustomerRequiredValidation" suggest="handleRegionSuggest" filterSuggests="true"-->
					<!--	suggestionItemSelected="onSelectRegion" suggestionRows="{ path: '/ZAE_VH_Region', sorter: { path: 'Region' },suspended: true, length: 10 }">-->
					<!--	<suggestionColumns>-->
