					<!--				<Label text="{RegionName}"/>-->
					<!--			</cells>-->
					<!--		</ColumnListItem>-->
					<!--	</suggestionRows>-->
					<!--</Input>-->
					<Label text="{i18n>Country}"/>
					<MultiInput id="COUNTRY" valueHelpRequest="fnShowCountryValueHelp" valueHelpOnly="false" showValueHelp="true"
						tokenUpdate="onCountryTokenUpdate" showSuggestion="true" suggestionItemSelected="onSelectCountry"
						liveChange="handleCreateCustomerInputValidation"
						suggestionRows="{ path: '/ZAE_VH_Country', sorter: { path: 'Country' },suspended: true, length: 10 }" filterSuggests="true"
						suggest="handleCountrySuggest">
						<suggestionColumns>
							<Column>
								<Label text="{i18n>Country}"/>
							</Column>
							<Column>
								<Label text="{i18n>CountryName}"/>
							</Column>
							<Column visible="false">
								<Label text="{i18n>CountryCode}"/>
							</Column>
						</suggestionColumns>
						<suggestionRows>
							<ColumnListItem>
								<cells>
									<Label text="{Country}"/>
									<Label text="{CountryName}"/>
									<Label text="{CountryCode}"/>
								</cells>
							</ColumnListItem>
						</suggestionRows>
					</MultiInput>
					<Label text="{i18n>Region}"/>
					<MultiInput id="REGION" valueHelpRequest="fnShowRegionValueHelp" valueHelpOnly="false" showValueHelp="true"
						tokenUpdate="onRegionTokenUpdate" showSuggestion="true" suggestionItemSelected="onSelectRegion"
						liveChange="handleCreateCustomerInputValidation"
						suggestionRows="{ path: '/ZAE_VH_Region', sorter: { path: 'Region' },suspended: true, length: 10 }" filterSuggests="true"
						suggest="handleRegionSuggest">
						<suggestionColumns>
							<Column>
								<Label text="{i18n>Region}"/>
							</Column>
							<Column>
								<Label text="{i18n>RegionName}"/>
							</Column>
						</suggestionColumns>
						<suggestionRows>
							<ColumnListItem>
								<cells>
									<Label text="{Region}"/>
									<Label text="{RegionName}"/>
								</cells>
							</ColumnListItem>
						</suggestionRows>
					</MultiInput>
					<Label text="{i18n>MobNo}"/>
					<MaskInput id="MOBILENO" change="handleMobileNoValidation"/>
					<Label text="{/#ZAE_FM_SC_CUST_CREATE_FRM_CI/FaxNumber/@sap:label}"/>
					<MaskInput id="FAXNUMBER" change="handleMobileNoValidation"/>
					<!--<Input id="MOBNO" liveChange="handleCreateCustomerInputValidation"/>-->
					<Label text="{i18n>TelNo}"/>
					<MaskInput id="TELNO" change="handleTeliphoneNoValidation"/>
					<!--<Label text="{i18n>FaxNo}"/>-->
					<!--<Input id="TELNO" liveChange="handleCreateCustomerInputValidation"/>-->
					<Label text="{i18n>Email}"/>
					<Input id="EMAIL" liveChange="handleEmailInputChange"/>
					<Label text="{i18n>CPRNo}"/>
					<Input id="CPRNO" liveChange="handleCreateCustomerInputValidation" maxLength="25"/>
					<Label text="{i18n>Street}"/>
					<Input id="STREET" maxLength="{path: '/#ZAE_FM_SC_CUST_CREATE_FRM_CI/Street/@maxLength', formatter: 'parseInt'}"/>
					<Label text="{i18n>HouseNo}"/>
					<Input id="HOUSENO" maxLength="{path: '/#ZAE_FM_SC_CUST_CREATE_FRM_CI/HouseNo/@maxLength', formatter: 'parseInt'}"/>
					<Label text="{i18n>POBox}"/>
					<Input id="POBOX" maxLength="{path: '/#ZAE_FM_SC_CUST_CREATE_FRM_CI/PoBox/@maxLength', formatter: 'parseInt'}"/>
					<Label text="{i18n>PostalCode}"/>
					<Input id="POSTALCODE" maxLength="{path: '/#ZAE_FM_SC_CUST_CREATE_FRM_CI/PostlCode/@maxLength', formatter: 'parseInt'}"/>
					<Label text="{i18n>City}"/>
					<Input id="CITY" liveChange="fnCheckCreateCustomerRequiredValidation"
						maxLength="{path: '/#ZAE_FM_SC_CUST_CREATE_FRM_CI/City/@maxLength', formatter: 'parseInt'}"/>
					<Label text="{i18n>Location}"/>
					<!--<Input id="LOCATION" liveChange="fnCheckCreateCustomerRequiredValidation"-->
					<!--	maxLength="{path: '/#ZAE_FM_SC_CUST_CREATE_SORG/Location/@maxLength', formatter: 'parseInt'}"/>-->
					<Select id="REGIOGROUP" forceSelection="false"
						items="{ path: '/I_RegionalStructureGroupingVH', sorter: { path: 'RegionalStructureGrouping' } }"
						change="fnCheckCreateCustomerRequiredValidation">
						<core:Item key="{RegionalStructureGrouping}" text="{RegionalStructureGroupingDesc}" additionalText="{RegionalStructureGrouping}"/>
					</Select>
					<Label text="{i18n>Nationality}"/>
					<MultiInput id="NATIONALITY" valueHelpRequest="fnShowNationalityValueHelp" valueHelpOnly="false" showValueHelp="true"
						tokenUpdate="onNationalityTokenUpdate" showSuggestion="true" suggestionItemSelected="onSelectNationality"
						liveChange="handleCreateCustomerInputValidation"
						suggestionRows="{ path: '/ZAE_VH_Country', sorter: { path: 'Country' },suspended: true, length: 10 }" filterSuggests="true"
						suggest="handleNationalitySuggest">
						<suggestionColumns>
							<Column>
								<Label text="{i18n>Country}"/>
							</Column>
							<Column>
								<Label text="{i18n>CountryName}"/>
							</Column>
							<Column visible="false">
								<Label text="{i18n>CountryCode}"/>
							</Column>
						</suggestionColumns>
						<suggestionRows>
							<ColumnListItem>
								<cells>
									<Label text="{Country}"/>
									<Label text="{CountryName}"/>
									<Label text="{CountryCode}"/>
								</cells>
							</ColumnListItem>
						</suggestionRows>
					</MultiInput>
					<Label text="{i18n>Language}"/>
					<Input id="LANGUAGE" showValueHelp="true" showSuggestion="true" liveChange="onLanguage" suggest="handleLanguageSuggest"
						valueHelpRequest="handleValueHelpLanguage" filterSuggests="true" suggestionItemSelected="onSelectLanguage"
						suggestionRows="{ path: '/ZAE_I_Languages', sorter: { path: 'LanguageISOCode' },suspended: true, length: 10 }">
						<suggestionColumns>
							<Column>
								<Label text="{/#ZAE_I_Languages/LanguageName/@sap:label}"/>
							</Column>
							<Column>
								<Label text="{/#ZAE_I_Languages/LanguageISOCode/@sap:label}"/>
							</Column>
						</suggestionColumns>
						<suggestionRows>
							<ColumnListItem>
								<cells>
									<Label text="{LanguageName}"/>
									<Label text="{LanguageISOCode}"/>
								</cells>
							</ColumnListItem>
						</suggestionRows>
					</Input>
					<!--<smartField:SmartField entitySet="ZAE_F_Customer" value="{Region}" id="REGION" change="fnCheckCreateCustomerRequiredValidation"/>-->
					<!--<Label text="Postal Code"  />-->
					<!--<Input id="PostlCode" change="fnCheckCreateCustomerRequiredValidation"/>-->
				</f:content>
			</f:SimpleForm>
		</l:content>
	</l:VerticalLayout>
</core:FragmentDefinition>