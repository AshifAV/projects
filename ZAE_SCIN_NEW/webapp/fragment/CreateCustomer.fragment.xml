<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core"
	xmlns:smartField="sap.ui.comp.smartfield">
	<l:VerticalLayout class="sapUiContentPadding" width="100%">
		<l:content>
			<f:SimpleForm id="appointmentCreateForm" editable="true" layout="ResponsiveGridLayout" singleContainerFullSize="false">
				<f:content>
					<Label text="{i18n>SalesOrg}"/>
					<Select id="SALESORGANIZATION" change="fnSalesOrgChange" showSecondaryValues="true"
						items="{mCreateCustomer>/oCreateCustomerData/CreateCustomerSalesOrg}" forceSelection="false">
						<core:ListItem key="{mCreateCustomer>SalesOrganization}" text="{mCreateCustomer>SalesOrganizationName}"
							additionalText="{mCreateCustomer>SalesOrganization}"/>
					</Select>
					<Label text="{i18n>DistrChannel}"/>
					<Select id="DISTRIBUTIONCHANNEL" showSecondaryValues="true" change="fnDistributionChange" forceSelection="false"
						items="{mCreateCustomer>/oCreateCustomerData/CreateCustomerDC}">
						<core:ListItem key="{mCreateCustomer>DistributionChannel}" text="{mCreateCustomer>DistributionChannelName}"
							additionalText="{mCreateCustomer>DistributionChannel}"/>
					</Select>
					<Label text="{i18n>Division}"/>
					<Select id="DIVISION" showSecondaryValues="true" change="fnCheckCreateCustomerRequiredValidation" forceSelection="false"
						items="{mCreateCustomer>/oCreateCustomerData/CreateCustomerDivision}">
						<core:ListItem key="{mCreateCustomer>Division}" text="{mCreateCustomer>DivisionName}" additionalText="{mCreateCustomer>Division}"/>
					</Select>
					<Label text="{i18n>Salutation}"/>
					<!--<smartField:SmartField entitySet="ZAE_F_Customer" value="{Saluatation}" id="SALUTATION" change="fnCheckCreateCustomerRequiredValidation"/>-->
					<Select id="SALUTATION" showSecondaryValues="true" change="fnCheckCreateCustomerRequiredValidation" forceSelection="false"
						items="{path: '/ZAE_VH_CustomerSaluatation_01', length:200}">
						<core:ListItem key="{title}" text="{TitleText}" additionalText="{title}"/>
					</Select>
					<Label text="{i18n>FirstName}"/>
					<Input id="FIRSTNAME" liveChange="fnCheckCreateCustomerRequiredValidation"
						maxLength="{path: '/#ZAE_FM_SC_CUST_CREATE_FRM_CI/FirstName/@maxLength', formatter: 'parseInt'}"/>
					<Label text="{i18n>LastName}"/>
					<Input id="FAMILYNAME" liveChange="fnCheckCreateCustomerRequiredValidation"
						maxLength="{path: '/#ZAE_FM_SC_CUST_CREATE_FRM_CI/LastName/@maxLength', formatter: 'parseInt'}"/>
					<Label text="{i18n>NameMiddle}"/>
					<Input id="NAMEMIDDLE" liveChange="fnCheckCreateCustomerRequiredValidation"
						maxLength="{path: '/#ZAE_FM_SC_CUST_CREATE_FRM_CI/MiddleName/@maxLength', formatter: 'parseInt'}"/>
					<!--<Label text="{i18n>Country}"  />-->
					<!--<Input id="COUNTRY" editable="true" type="Text" showSuggestion="true" showValueHelp="true" valueHelpRequest="fnShowCountryValueHelp"-->
