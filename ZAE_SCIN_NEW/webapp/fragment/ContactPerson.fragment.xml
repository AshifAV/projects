						change="_fnContractButtonCreateButtonEnabledState">
						<core:Item key="{RegionalStructureGrouping}" text="{RegionalStructureGroupingDesc}" additionalText="{RegionalStructureGrouping}"/>
					</Select>
					<Label text="{i18n>Street}"/>
					<Input id="STREET" maxLength="{path: '/#ZAE_FM_SC_CONTACT_CREATE/Street/@maxLength', formatter: 'parseInt'}"/>
