					<Label text="{i18n>Email}"/>
					<Input id="EMAIL" liveChange="handleEmailInputChange"/>
					<Label text="{i18n>CPRNo}"/>
					<Input id="CPRNO" liveChange="handleCreateContactPersonInputValidation" maxLength="25"/>
					<Label text="{i18n>City}"/>
					<Input id="CITY" change="_fnContractButtonCreateButtonEnabledState"
						maxLength="{path: '/#ZAE_FM_SC_CONTACT_CREATE/City/@maxLength', formatter: 'parseInt'}"/>
					<Label text="{i18n>Location}"/>
					<Select id="REGIOGROUP" forceSelection="false"
