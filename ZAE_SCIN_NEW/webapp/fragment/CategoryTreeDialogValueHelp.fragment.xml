<core:FragmentDefinition xmlns="sap.ui.table" xmlns:m="sap.m" xmlns:core="sap.ui.core">
	<m:Dialog id="CategoryVHDialog" class="sapUiPopupWithPadding" title="{i18n>CategoryTreeVHDialogTitle}" afterClose="afterClose"
		resizable="true">
		<m:MessageStrip class="sapUiResponsiveMargin sapUiNoMarginTop" id="CategoryTreeVHMessageStrip" showCloseButton="false" showIcon="true"
			visible="false"/>
		<TreeTable id="CategoryTreeTable" selectionMode="MultiToggle" width="50rem" rowSelectionChange="onTreeMultiRowSelect"
			enableSelectAll="false">
			<extension>
				<m:Toolbar>
					<m:SearchField id="searchField" showRefreshButton="true" tooltip="{i18n>masterSearchTooltip}" search=".onSearchTreeTable" width="auto"></m:SearchField>
				</m:Toolbar>
			</extension>
			<columns>
				<!--	<Column width="22rem">
					<m:Label text=""/>
					<template>
						<m:CheckBox selected="true"/>
					</template>
				</Column>-->
				<Column width="22rem">
					<m:Label text="{i18n>Name}"/>
					<template>
						<m:Text text="{cat_label}" wrapping="false"/>
					</template>
				</Column>
				<Column >
					<m:Label text="{i18n>ID}"/>
					<template>
						<m:Text text="{cat_id}" wrapping="false"/>
					</template>
				</Column>
				<Column visible="{path:'mCustIdentification>/customerInfo',formatter:'.aditionalColumVisible'}">
					<m:Label text="{i18n>Info}"/>
					<template>
						<m:Text text="{Info}" wrapping="false"/>
					</template>
				</Column>
				<Column visible="{path:'mCustIdentification>/customerInfo',formatter:'.aditionalColumVisible'}">
					<m:Label text="{i18n>ValidFrom}"/>
					<template>
						<m:Text text="{path: 'ValidFrom', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'MMM dd,yyyy' }}" wrapping="false"/>
					</template>
				</Column>
				<Column visible="{path:'mCustIdentification>/customerInfo',formatter:'.aditionalColumVisible'}">
					<m:Label text="{i18n>ValidTo}"/>
					<template>
						<m:Text text="{path: 'ValidTo', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'MMM dd,yyyy' }}" wrapping="false"/>
					</template>
				</Column>
				<Column >
					<m:Label text="{i18n>ServiceStatus}"/>
					<template>
						<m:Text text="{ServiceStatus}" wrapping="false"/>
					</template>
				</Column>
			</columns>
		</TreeTable>
		<m:MultiInput width="50rem" id="CategoryMultiInput" enabled="false"/>
		<m:beginButton>
			<m:Button id="idOK" text="{i18n>BUTTON_Ok}" press="onPressOk"/>
		</m:beginButton>
		<m:endButton>
			<m:Button text="{i18n>BUTTON_Cancel}" press="onCancelPressed"/>
		</m:endButton>
	</m:Dialog>
</core:FragmentDefinition>