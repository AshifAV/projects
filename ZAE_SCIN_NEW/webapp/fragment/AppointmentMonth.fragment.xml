<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns:layout="sap.ui.layout"
	xmlns:form="sap.ui.layout.form" xmlns:smartForm="sap.ui.comp.smartform" xmlns:smartField="sap.ui.comp.smartfield"
	xmlns:unified="sap.ui.unified" xmlns:smartFilterBar="sap.ui.comp.smartfilterbar" xmlns:smartTable="sap.ui.comp.smarttable">
	<Dialog title="{i18n>AppointmentMonthView}" contentWidth="80em" contentHeight="70em">
		<SinglePlanningCalendar id="idSinglePlanningCalendar" class="" headerDateSelect="handleHeaderDateSelect"
			startDateChange="handleStartDateChange" cellPress="onChangeSelectedDate" enableAppointmentsDragAndDrop="false"
			enableAppointmentsResize="{settings>/enableAppointmentsResize}" enableAppointmentsCreate="{settings>/enableAppointmentsCreate}"
			stickyMode="{settings>/stickyMode}" appointments="{path: '/ZAE_I_Appointment_18', sorter: { path: 'UniqueKey', descending: true} }"
			fullDay="false" startHour="07" endHour="24">
			<views>
				<SinglePlanningCalendarMonthView key="MonthView" title="{i18n>Month}"/>
			</views>
			<appointments>
				<unified:CalendarAppointment title="Appointments:{AppCount}" text="{AppCount}" type="" icon="" key="{UniqueKey}"
					startDate="{ parts: [ 'fromdate', 'fromtime' ], formatter: '.dateTimeToDate' }"
					endDate="{ parts: [ 'enddate', 'endtime' ], formatter: '.dateTimeToDate' }"></unified:CalendarAppointment>
			</appointments>
		</SinglePlanningCalendar>
		<buttons>
			<Button press="onClose" text="{i18n>Close}"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>