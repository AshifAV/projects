<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:smartfield="sap.ui.comp.smartfield" xmlns:f="sap.ui.layout.form" xmlns="sap.m"
	xmlns:l="sap.ui.layout">
	<Dialog afterClose="afterClose" class="sapUiPopupWithPadding" id="SSOD_B104Dialog" title="{i18n>SSOD_B104}">
		<content>
			<MessageStrip class="sapUiResponsiveMargin sapUiNoMarginTop" id="SSOD_B104MessageStrip" showCloseButton="false" showIcon="true" type="Error"
				visible="false"/>
			<Table id="SplitTable" items="{mSplit>/TableList/}" visible="true" sticky="ColumnHeaders" mode="MultiSelect"
				selectionChange="fnSplitTableSelectionChange">
				<!--modelContextChange="onModelContextChange" -->
				<headerToolbar>
					<OverflowToolbar>
						<content>
							<!--<Label text="Split Accounting Indicator:"/>-->
							<Label text="Split Accounting Indicator AI 2:"/>
							<Select id="SplitAccountingIndicator" items="{mSplit>/NewAccIndVH/}" forceSelection="false" change="fnOnSelectHeaderAccInd">
								<core:Item key="{mSplit>AccountingIndicatorSplit}"
									text="{parts: ['mSplit>AccountingIndicatorSplitText', 'mSplit>AccountingIndicatorSplit'], formatter: '.formatNameAndValuePair'}"></core:Item>
							</Select>
							<!--Added for AE-4241-->
							<Label text="Split Accounting Indicator AI 3:"/>
							<Select id="SplitAccountingIndicator3" items="{mSplit>/NewAccIndVH1/}" forceSelection="false" change="fnOnSelectHeaderAccInd3">
								<core:Item key="{mSplit>AccountingIndicatorSplit}"
									text="{parts: ['mSplit>AccountingIndicatorSplitText', 'mSplit>AccountingIndicatorSplit'], formatter: '.formatNameAndValuePair'}"></core:Item>
							</Select>
							<ToolbarSpacer/>
						</content>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column>
						<Text text="Item"/>
					</Column>
					<Column>
						<Text text="High Level Item"/>
					</Column>
					<Column>
						<Text text="Complaint"/>
					</Column>
					<Column>
						<Text text="Quantity"/>
					</Column>
					<Column>
						<Text text="Current AI"/>
					</Column>
					<Column>
						<!--	<Text text="Proposed AI"/>-->
						<Text text="Split AI 1"/>
					</Column>
					<Column width="12em">
						<Text text="Split AI 2"/>
					</Column>
					<Column width="12em">
						<Text text="Split AI 3"/>
					</Column>
					<Column width="5em" hAlign="End">
						<Text id="SplitCustom1" text="Split 1"/>
					</Column>
					<Column width="5em" hAlign="End">
						<Text id="SplitCustom2" text="Split 2"/>
					</Column>
					<Column width="6em">
						<!--	<Text id="ProposedSplit" text="Split To"/>-->
						<Text id="ProposedSplit" text="Split 3"/>
					</Column>
					<Column id="ColumnCustomer">
						<Text text="Business Partner"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem >
						<cells>
							<Text text="{mSplit>Item}"/>
							<Text text="{mSplit>HigherLevelItem}"/>
							<Text text="{mSplit>MaterialName}"/>
							<ObjectNumber number="{mSplit>ItemQuantity}" unit="{mSplit>QuantityUnit}"/>
							<Text text="{parts: ['mSplit>CurrentAccountingIndicatorName', 'mSplit>CurrentAccountingIndicator'], formatter: '.formatNameAndValuePair'}"/>
							<Text text="{parts: ['mSplit>ProposedAccIndName', 'mSplit>ProposedAccInd'], formatter: '.formatNameAndValuePair'}"/>
							<Select selectedKey="{mSplit>NewAccInd}" items="{mSplit>NewAccIndVH}" forceSelection="false" change="fnNewAccIndSelectionChange2">
								<core:Item key="{mSplit>AccountingIndicatorSplit}"
									text="{parts: ['mSplit>AccountingIndicatorSplitText', 'mSplit>AccountingIndicatorSplit'], formatter: '.formatNameAndValuePair'}"></core:Item>
							</Select>
							<Select selectedKey="{mSplit>NewAccInd1}" items="{mSplit>NewAccIndVH1}" forceSelection="false" change="fnNewAccIndSelectionChange3">
								<core:Item key="{mSplit>AccountingIndicatorSplit}"
									text="{parts: ['mSplit>AccountingIndicatorSplitText', 'mSplit>AccountingIndicatorSplit'], formatter: '.formatNameAndValuePair'}"></core:Item>
							</Select>
							<Input value="{mSplit>SplitCustomer1}" type="Number" valueLiveUpdate="true" liveChange="fnliveChangeSplit"/>
							<Input value="{mSplit>SplitCustomer2}" type="Number" valueLiveUpdate="true" liveChange="fnliveChangeSplit"/>
							<Text text="{mSplit>ProposedSplit}"/>
							<Input type="Text" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="handleBPValueHelp" width="6rem" enabled="false" value="{mSplit>Customer}"
								change="fnSubmitButonEnable" textFormatMode="ValueKey"></Input>
							<!--<ComboBox selectedKey="{mSplit>Customer}" items="{/ZAE_VH_BusinessPartner_07}" forceSelection="false" change="fnSubmitButonEnable"-->
							<!--	enable="{mSplit>SplitEnable}">-->
							<!--	<core:Item key="{Partner}" text="{PartnerName}"></core:Item>-->
							<!--</ComboBox>-->
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<beginButton>
			<Button id="IDSubmit" press="onSubmitPressed" text="{i18n>BUTTON_Submit}"/>
		</beginButton>
		<endButton>
			<Button press="onCancelPressed" text="{i18n>BUTTON_Cancel}"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>