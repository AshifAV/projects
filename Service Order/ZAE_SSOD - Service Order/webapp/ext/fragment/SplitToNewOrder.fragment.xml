<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core"
	xmlns:smartField="sap.ui.comp.smartfield">
	<l:VerticalLayout width="100%">
		<l:content>
			<MessageStrip class="sapUiResponsiveMargin" id="SSOD_B148MessageStrip" showCloseButton="false" showIcon="true" type="Error" visible="false"></MessageStrip>
			<f:SimpleForm id="UpdateRuleDialog" editable="true" layout="ResponsiveGridLayout" singleContainerFullSize="false">
				<f:content>
					<Label text="{i18n>ProcessType}"/>
					<Select forceSelection="false" id="ProcessTypeInput" showSecondaryValues="true"
						items="{ path: '/ZAE_I_TC_SSOD_21', sorter: { path: 'ProcessTypeCrt' } }" change="fnCheckProcessType">
						<core:ListItem key="{ProcessTypeCrt}" additionalText="{ProcessTypeCrt}" text="{ProcessTypeText}"/>
					</Select>
					<Label text="{i18n>Partner}"/>
					<Input id="PartnerInput" value="" showValueHelp="true" valueHelpRequest="handleValueHelp"/>
				</f:content>
			</f:SimpleForm>
		</l:content>
	</l:VerticalLayout>
</core:FragmentDefinition>