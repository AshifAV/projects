<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:smartfield="sap.ui.comp.smartfield" xmlns="sap.m">
	<Dialog afterClose="afterClose" class="sapUiPopupWithPadding" id="SSOD_B160Dialog" title="{i18n>SSOD_B160}">
		<content>
			<Label labelFor="CompDescInput" required="true"/>
			<Input id="CompDescInput" value="{mCompDesc>/CompDesc}" class="sapUiSmallMarginBottom" maxLength="40"/>
		</content>
		<beginButton>
			<Button press="onSubmitPressed" text="{i18n>BUTTON_Submit}"/>
		</beginButton>
		<endButton>
			<Button press="onCancelPressed" text="{i18n>BUTTON_Cancel}"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>