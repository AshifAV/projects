<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core"
	xmlns:smartField="sap.ui.comp.smartfield">
	<l:VerticalLayout class="sapUiContentPadding" width="100%">
		<l:content>
			<MessageStrip class="sapUiResponsiveMargin sapUiNoMarginTop" id="SSOD_B37MessageStrip" showCloseButton="false" showIcon="true"
				type="Error" visible="false"></MessageStrip>
			<f:SimpleForm id="idBillingDateDialog" editable="true" layout="ResponsiveGridLayout" singleContainerFullSize="false">
				<f:content>
					<Label text="Billing Date" required="true"/>
					<DatePicker id="billingDateInput" placeholder="Enter Billing Date" class="sapUiSmallMarginBottom"/>
				</f:content>
			</f:SimpleForm>
		</l:content>
	</l:VerticalLayout>
</core:FragmentDefinition>