<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core"
	xmlns:smartField="sap.ui.comp.smartfield">
	<l:VerticalLayout class="sapUiContentPadding" width="100%">
		<l:content>
			<MessageStrip class="sapUiResponsiveMargin sapUiNoMarginTop" id="SSOD_B71MessageStrip" showCloseButton="false" showIcon="true" type="Error"
				visible="false"></MessageStrip>
			<f:SimpleForm id="SSOD_B71SimpleForm" editable="true" layout="ResponsiveGridLayout" singleContainerFullSize="false">
				<f:content>
					<Label text="{i18n>BillingRuleInput}" labelFor="EstTypeInput"/>
					<Input id="BillingRuleInput" type="Text" showSuggestion="true" valueHelpOnly="true" showValueHelp="true" valueHelpRequest="onShowBillingRuleVH"
						class="sapUiSmallMarginBottom"/>
					<Label text="{i18n>PartnerChargeInput}" labelFor="PartnerChargeInput"/>
					<Input id="PartnerChargeInput" type="Text" visible="false" showSuggestion="true" valueHelpOnly="true" showValueHelp="true" valueHelpRequest="onShowChargePartnerVH"
						class="sapUiSmallMarginBottom"/>
				</f:content>
			</f:SimpleForm>
		</l:content>
	</l:VerticalLayout>
</core:FragmentDefinition>