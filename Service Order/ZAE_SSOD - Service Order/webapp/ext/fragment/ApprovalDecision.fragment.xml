<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog class="sapUiSizeCompact sapUiContentPadding" contentHeight="30em" contentWidth="90em" resizable="true" title="{i18n>SSOD_B82}">
		<MessageStrip class="sapUiResponsiveMargin" id="SSOD_B82MessageStrip" showCloseButton="false" showIcon="true" type="Error" visible="false"></MessageStrip>
		<content>
			<Table id="idAppDecTable" growing="true" growingThreshold="10" paste="onPaste" items="{mApprovalDec>/TableData/}" inset="false"
				alternateRowColors="true">
				<headerToolbar>
					<OverflowToolbar >
						<Title text="{i18n>SSOD_B82}" level="H2"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column width="4em" hAlign="Center">
						<Label text="Operation"/>
					</Column>
					<Column width="15em" hAlign="Center">
						<Label text="Service Type"/>
					</Column>
					<Column width="15em" hAlign="Center">
						<Label text="Approval Status" required="true"/>
					</Column>
					<Column width="15em" hAlign="Center">
						<Label text="Rejection Reason"/>
					</Column>
					<Column width="15em" hAlign="Center">
						<Label text="To Service Type"/>
					</Column>
					<Column width="4em" hAlign="Center">
						<Text text="Actions"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{mApprovalDec>Operation}"/>
							<Text text="{mApprovalDec>ServiceType}"/>
							<Select forceSelection="false" showSecondaryValues="false" items="{/ZAE_VH_ServiceApprovalStatus}" change="onChangeApprovalStatus"
								selectedKey="{mApprovalDec>ApprovalStatus}">
								<core:ListItem key="{ApprovalStatus}" text="{parts: ['ApprovalStatusDesc', 'ApprovalStatus'], formatter: '.formatNameAndValuePair'}"/>
							</Select>
							<Select forceSelection="false" showSecondaryValues="false" items="{/ZAE_VH_RejectionReason}" enabled="{mApprovalDec>RejReasonEnabled}"
								change="fnSubmitButonValidation" selectedKey="{mApprovalDec>RejectionReason}">
								<core:ListItem key="{RejectionReason}" text="{parts: ['RejectionReasonName', 'RejectionReason'], formatter: '.formatNameAndValuePair'}"/>
							</Select>
							<Select forceSelection="false" showSecondaryValues="false" items="{/ZAE_I_TC_SSOD_OPR}" enabled="{mApprovalDec>ToSrvTypeEnabled}"
								change="fnSubmitButonValidation" selectedKey="{mApprovalDec>ToServiceType}">
								<core:ListItem key="{ServiceType}" text="{parts: ['ServiceTypeName', 'ServiceType'], formatter: '.formatNameAndValuePair'}"/>
							</Select>
							<Button icon="sap-icon://delete" type="Transparent" press="onDeletePress"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<buttons>
			<Button id="BTNSubmit" text="Submit" press="onSubmit"/>
			<Button text="Reset" press="onReset"/>
			<Button text="Cancel" press="onCancel"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>