<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns="sap.m">
	<l:VerticalLayout class="sapUiContentPadding" width="100%">
		<l:content>
			<MessageStrip class="sapUiResponsiveMargin sapUiNoMarginTop" id="SSOD_B52MessageStrip" showCloseButton="false" showIcon="true" type="Error"
				visible="false"></MessageStrip>
			<f:SimpleForm id="idUpdatePartnerDialog" editable="true" layout="ResponsiveGridLayout" singleContainerFullSize="false">
				<f:content>
					<Label text="{i18n>PartnerInput}" required="true"/>
					<Input id="PartnerInput" required="true" type="Text" showSuggestion="true" showValueHelp="true" valueHelpRequest="onShowPartnerVH"
						class="sapUiSmallMarginBottom"/>
				</f:content>
			</f:SimpleForm>
		</l:content>
	</l:VerticalLayout>
</core:FragmentDefinition>