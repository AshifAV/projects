	xmlns:smartField="sap.ui.comp.smartfield">
	<l:VerticalLayout width="100%">
		<l:content>
			<MessageStrip class="sapUiResponsiveMargin" id="SSOD_B138MessageStrip" showCloseButton="false" showIcon="true" type="Error" visible="false"></MessageStrip>
			<f:SimpleForm id="FragUpdatePriceDialog" editable="true" layout="ResponsiveGridLayout" singleContainerFullSize="false">
				<f:content>
