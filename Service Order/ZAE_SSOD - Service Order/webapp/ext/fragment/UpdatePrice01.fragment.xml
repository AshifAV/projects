					<!--					<Label labelFor="CurrencyInput"/>
					<ComboBox id="CurrencyInput" items="{/ZAE_I_ServiceOrderCurrency}">
						<core:Item key="{TransactionCurrency}" text="TransactionCurrency}"/>
						<core:Item key="{CompanyCodeCurrency}" text="{CompanyCodeCurrency}"/>
					</ComboBox>-->
					<Label text="Currency"/>
					<Select forceSelection="false" id="CurrencyInput" showSecondaryValues="true" items="{ path: '/ZAE_I_ServiceOrderCurrency_01' }">
						<core:ListItem key="{Currency}" text="{Currency}"/>
					</Select>
				</f:content>
			</f:SimpleForm>
		</l:content>
	</l:VerticalLayout>
</core:FragmentDefinition>