<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:smartfield="sap.ui.comp.smartfield" xmlns="sap.m">
	<Dialog afterClose="afterClose" class="sapUiPopupWithPadding" id="SSOD_B163Dialog" title="{i18n>SSOD_B163}">
		<content>
			<Label labelFor="CatID" required="true"/>
			<Input id="CatID" showSuggestion="true" showValueHelp="true" valueHelpRequest="handleValueHelp" class="sapUiSmallMarginBottom" maxLength="40"/>
		</content>
		<beginButton>
			<Button press="onSubmitPressed" text="{i18n>BUTTON_Submit}"/>
		</beginButton>
		<endButton>
			<Button press="onCancelPressed" text="{i18n>BUTTON_Cancel}"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>