                "type": "OData",
                "settings": {
                    "localUri": "localService/metadata.xml"
                }
            },
            "ZAE_FM_DOC_SIMULATE_GET_PRICE_SRV": {
                "uri": "/sap/opu/odata/sap/ZAE_FM_DOC_SIMULATE_GET_PRICE_SRV/",
                "type": "OData",
                "settings": {
                    "localUri": "localService/metadata.xml"
                }
            },
            "CV_ATTACHMENT_SRV": {
                "uri": "/sap/opu/odata/sap/CV_ATTACHMENT_SRV/",
