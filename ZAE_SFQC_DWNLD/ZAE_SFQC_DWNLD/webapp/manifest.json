        "applicationVersion": {
            "version": "1.0.0"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "sourceTemplate": {
            "id": "servicecatalog.connectivityComponentForManifest",
            "version": "0.0.0",
            "toolsId": "60fa98d2-1f97-45c0-b278-cafbad558b77"
        },
        "dataSources": {
            "appModel": {
                "uri": "model/app.json",
