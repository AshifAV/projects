									items="{ path: 'app>/pages/Overview/paymentTerms' }" showSecondaryValues="true">
									<core:ListItem key="{app>CustomerPaymentTerms}" text="{app>CustomerPaymentTermsName}" additionalText="{app>CustomerPaymentTerms}"/>
								</Select>
							</f:fields>
						</f:FormElement>
						<!-- TODO: Remove inquiry condition from visible once logic fixed -->
						<f:FormElement label="{i18n>DownPaymentAmount}"
