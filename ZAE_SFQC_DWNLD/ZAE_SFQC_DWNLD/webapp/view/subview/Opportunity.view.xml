<mvc:View xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
	controllerName="com.globalintelli.ZAE_SFQC.controller.subview.Opportunity">
	<VBox id="overviewPage">
		<smartFilterBar:SmartFilterBar id="opportunityInput" filterChange="onChangefilter" entitySet="ZAE_F_SFQC_01" showFilterConfiguration="false"
			useToolbar="false" class="smartFilterBar sapUiNoMargin" initialized="onOpportunityInputInitialized" search="onOpportunityInputSearch"
			showGoOnFB="{= !${app>/pages/isBusy} }">
			<smartFilterBar:controlConfiguration>
				<smartFilterBar:ControlConfiguration key="SalesOrganization" visibleInAdvancedArea="true" preventInitialDataFetchInValueHelpDialog="false"
					filterType="single" index="1" change="onSalesAreaChange"></smartFilterBar:ControlConfiguration>
				<smartFilterBar:ControlConfiguration key="DistributionChannel" visibleInAdvancedArea="true" preventInitialDataFetchInValueHelpDialog="false"
					filterType="single" index="2" change="onSalesAreaChange2"></smartFilterBar:ControlConfiguration>
				<smartFilterBar:ControlConfiguration key="Division" visibleInAdvancedArea="true" preventInitialDataFetchInValueHelpDialog="false"
					filterType="single" index="3" change="onSalesAreaChange3"></smartFilterBar:ControlConfiguration>
				<smartFilterBar:ControlConfiguration key="SalesOffice" visibleInAdvancedArea="true" preventInitialDataFetchInValueHelpDialog="false"
					filterType="single" index="4"></smartFilterBar:ControlConfiguration>
				<smartFilterBar:ControlConfiguration key="Equipment" visibleInAdvancedArea="true" preventInitialDataFetchInValueHelpDialog="false"
					filterType="single" index="5"></smartFilterBar:ControlConfiguration>
				<smartFilterBar:ControlConfiguration key="CustomerField" visibleInAdvancedArea="true" preventInitialDataFetchInValueHelpDialog="false"
					filterType="single" index="6"></smartFilterBar:ControlConfiguration>
			</smartFilterBar:controlConfiguration>
			<!--<smartFilterBar:layoutData>-->
			<!--	<FlexItemData shrinkFactor="0"/>-->
			<!--</smartFilterBar:layoutData>-->
		</smartFilterBar:SmartFilterBar>
		<VBox class="sapUiSmallMargin" id="EquipmentDetails">
			<core:Fragment fragmentName="com.globalintelli.ZAE_SFQC.view.fragment.OpportunityDetails" id="opportunityTab" type="XML"/>
		</VBox>
	</VBox>
</mvc:View>