						<!--<ObjectAttribute title="Cost Center" text="{/objectDescription/center}"/>
					<ObjectAttribute title="Email" text="{/objectDescription/email}"/>-->
					</layout:VerticalLayout>
					<layout:VerticalLayout class="sapUiMediumMarginEnd">
						<ObjectAttribute text="{parts: ['LicenseNum'], formatter: '.formatNameAndValuePair'}"
							title="{/#ZAE_I_WorkOrder_03Type/LicenseNum/@sap:label}"/>
						<!--<ObjectAttribute text="{LicenseNum} . {Equipment}"/>-->
						<!--<ObjectAttribute title="Cost Center" text="{/objectDescription/center}"/>
					<ObjectAttribute title="Email" text="{/objectDescription/email}"/>-->
					</layout:VerticalLayout>
					<layout:VerticalLayout class="sapUiMediumMarginEnd">
						<ObjectAttribute text="{parts: ['FleetUseText' , 'FleetUse'], formatter: '.formatNameAndValuePair'}" title="Usage Indicator"/>
					</layout:VerticalLayout>
				</layout:VerticalLayout>
				<layout:HorizontalLayout>
					<layout:VerticalLayout class="sapUiMediumMarginEnd">
						<ObjectAttribute text="{ConcatenatedActiveSystStsName}" title="System Status"/>
