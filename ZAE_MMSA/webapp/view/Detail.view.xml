										</Column>
										<Column>
											<Label text="{i18n>MaterialName}"/>
										</Column>
										<!--<Column>-->
										<!--	<Label text="{i18n>MaterialType}"/>-->
										<!--</Column>-->
									</suggestionColumns>
									<suggestionRows>
										<ColumnListItem>
