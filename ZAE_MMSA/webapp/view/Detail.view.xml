		</semantic:exitFullScreenAction>
		<semantic:footerCustomActions>
			<Button id="SCIN_B06" icon="sap-icon://alert" text="{= ${message>/}.length }" visible="{= ${message>/}.length > 0 }" type="Emphasized"
				press="onMessagePopoverPress"/>
			<Button id="btnYrdOpr" text="{i18n>Next}" press="onClickNxt" enabled="{detailView>/IsNextenabled}"/>
			<Button id="btnSubmit" text="{i18n>Submit}" press="btnSubmitPress" enabled="{detailView>/IsSubmitenabled}"/>
		</semantic:footerCustomActions>
	</semantic:SemanticPage>
</mvc:View>