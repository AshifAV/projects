					<!--	<ObjectAttribute title="{i18n>WarrantyStatus}"/>-->
					<!--	<ObjectStatus text="{WarrantyStatusText_new}" state="{path:'WarrantyStatusText_new' , formatter: '.Statuscolorformat'}"/>-->
					<!--</layout:VerticalLayout>-->
					<layout:VerticalLayout class="sapUiMediumMarginBegin">
						<ObjectAttribute title="{i18n>OEMWarrantyStatus}"/>
						<ObjectStatus text="{OEMWarrantyStatusText_new}" state="{path:'OEMWarrantyStatusText_new' , formatter: '.Statuscolorformat'}"/>
					</layout:VerticalLayout>
					<layout:VerticalLayout class="sapUiMediumMarginBegin">
						<ObjectAttribute title="{i18n>ContractStatus}"/>
						<ObjectStatus text="{ContractStatusText_new}" state="{path:'ContractStatusText_new' , formatter: '.Statuscolorformat'}"/>
					</layout:VerticalLayout>
					<layout:VerticalLayout class="sapUiMediumMarginBegin">
						<ObjectAttribute title="{i18n>RecallStatus}"/>
						<ObjectStatus id="ObjectStatusRecall" class="sapUiSmallMarginBottom"/>
					</layout:VerticalLayout>
				</layout:HorizontalLayout>
			</layout:HorizontalLayout>
