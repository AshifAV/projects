										change="onNextButtoncheck">
										<core:Item key="{DomainText}" text="{DomainText}"></core:Item>
									</Select>
								</f:FormElement>
								<f:FormElement label="{i18n>vehiclecondition}" class="sapUiTinyMarginTop"
									visible="{= ${detailView>/VisibleData/ChkVehCond} !== '1' ? true : false }">
									<Select id="idvehiclecondition" items="{/ZAE_I_VehicleConditionType}"
										required="{= ${detailView>/VisibleData/ChkVehCond} === '3' ? true : false }" forceSelection="false" width="auto" change="onNextButtoncheck">
										<core:Item key="{VehicleConditionTypeText}" text="{VehicleConditionTypeText}"></core:Item>
									</Select>
								</f:FormElement>
								<f:FormElement id="idFE2" label="{i18n>notes}" class="sapUiTinyMarginTop"
									visible="{= ${detailView>/VisibleData/ChkNote} !== '1' ? true : false }">
									<TextArea id="idnotes" required="{= ${detailView>/VisibleData/ChkNote} === '3' ? true : false }" width="100%" showExceededText="true"
										maxLength="500" liveChange="onNextButtoncheck" rows="3"></TextArea>
								</f:FormElement>
								<f:FormElement label="{i18n>servicerequest}" visible="{= ${detailView>/VisibleData/ChkAccAvl} !== '1' ? true : false }">
									<!--<f:fields>-->
									<!--	<Label text="{i18n>servicerequest}" required="{= ${detailView>/VisibleData/ChkAccAvl} === '3' ? true : false }"/>-->
									<!--</f:fields>-->
									<VBox id="idVBoxCheckList" items="{path:'to_ServiceRequestChecklist' , sorter: { path: 'CheckListId', descending: false} }">
										<CheckBox id="idservicerequest" text="{CheckListIdDesc}" select="onNextButtoncheck">
											<layoutData>
												<l:GridData linebreak="true" indentL="4" indentM="4"/>
											</layoutData>
										</CheckBox>
									</VBox>
								</f:FormElement>
