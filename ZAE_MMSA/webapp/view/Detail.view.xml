												<Label text="{Material}"/>
												<Label text="{MaterialName}"/>
												<!--<Label text="{MaterialType}"/>-->
											</cells>
										</ColumnListItem>
									</suggestionRows>
									<tokens>
										<Token key="{detailView>Material}" text="{parts: ['detailView>MaterialName', 'detailView>Material'], formatter: '.formatNameAndValuePair'}"/>
