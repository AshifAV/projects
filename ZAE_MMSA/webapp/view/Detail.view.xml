								<Text text="{detailView>QuantityUnit}"/>
								<ObjectNumber number="{detailView>NetPrice}" unit="{detailView>Currency}"/>
								<Text text="{detailView>Currency}"/>
								<ObjectNumber number="{detailView>Tax}" unit="{detailView>Currency}"/>
								<Text text="{detailView>Currency}"/>
								<ObjectNumber number="{detailView>TotalPrice}" unit="{detailView>Currency}"/>
								<Text text="{detailView>Currency}"/>
								<Button icon="sap-icon://delete" type="Transparent" press="onDeletePress" enabled="{detailView>Enabled}"/>
							</cells>
						</ColumnListItem>
					</items>
